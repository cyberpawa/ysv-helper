# Gemini Vision AI
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_PRIMARY_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"

# Telegram Bot & Mini App Security
BOT_TOKEN="12345678:AaBbCcDdEe..."
ADMIN_ID="123456789"
TRUSTED_USERS="123456789,987654321"
TEST_PHOTO_FILE_ID=""
